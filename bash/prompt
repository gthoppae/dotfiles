# shellcheck shell=bash
# Custom bash prompt: time + user@host + cwd + git branch/dirty + exit-code marker
# Sourced from ~/.bashrc by install.sh

# Lightweight git branch + dirty-state indicator
__ps1_git() {
    local b
    b=$(git symbolic-ref --short HEAD 2>/dev/null) || return
    local dirty=""
    git diff --quiet --ignore-submodules HEAD 2>/dev/null || dirty="*"
    printf ' (%s%s)' "$b" "$dirty"
}

__set_prompt() {
    local ec=$?                       # capture exit code first
    local reset='\[\e[0m\]'
    local grn='\[\e[1;32m\]'          # user@host
    local blu='\[\e[1;34m\]'          # cwd
    local ylw='\[\e[1;33m\]'          # git
    local red='\[\e[1;31m\]'          # error
    local dim='\[\e[2;37m\]'          # time

    local status=""
    [ "$ec" -ne 0 ] && status="${red}✘${ec} "

    PS1="${dim}\A${reset} ${grn}\u@\h${reset}:${blu}\w${reset}${ylw}\$(__ps1_git)${reset}\n${status}\$ "
}
PROMPT_COMMAND=__set_prompt
