# ~/.zshrc — managed by dotfiles repo, symlinked into place by install.sh.

eval "$(mise activate zsh)"

# --- history (persisted via the host-mounted ~/.history dir) ---
mkdir -p "$HOME/.history"
HISTFILE="$HOME/.history/zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt APPEND_HISTORY INC_APPEND_HISTORY SHARE_HISTORY \
       HIST_IGNORE_DUPS HIST_IGNORE_SPACE HIST_REDUCE_BLANKS

# zoxide (smarter cd: `z <dir>`, `zi` interactive)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# repo-managed fragments
source "$HOME/dotfiles/zsh/prompt.zsh"
